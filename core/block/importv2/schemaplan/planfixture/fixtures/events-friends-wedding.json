  "expect": {
    "differentKind": [["db-wedding-budget", "db-household-budget"]],
    "bundled": {
      "db-vendors": {"pPhone": "phone", "pEmail": "email"},
      "db-registry": {"pTags": "tag"},
      "db-bridesmaid-tasks": {"pDueDate": "dueDate", "pDone": "done"}
    },
    "notBundled": {
      "db-guests": ["pRsvpBy", "pSaveTheDate", "pPlusOne"],
      "db-vendors": ["pLastContacted"],
      "db-bachelorette": ["pTripStart"]
    },
    "separateRelation": [
      ["db-vendors:pStatus", "db-bridesmaid-tasks:pStatus", "db-bachelorette:pStatus"],
      ["db-wedding-budget:pCategory", "db-household-budget:pCategory"],
      ["db-vendors:pCost", "db-registry:pCost"]
    ]
  }
}
