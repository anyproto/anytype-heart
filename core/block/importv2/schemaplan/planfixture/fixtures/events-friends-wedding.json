      "properties": [
        {"id": "pStatus", "name": "Status", "format": "select",
         "options": ["Contacted", "Quote Received", "Booked", "Deposit Paid", "Paid in Full"]},
        {"id": "pPhone", "name": "Phone", "format": "phone"},
        {"id": "pEmail", "name": "Email", "format": "email"},
        {"id": "pCost", "name": "Cost", "format": "number"},
        {"id": "pContractSigned", "name": "Contract Signed", "format": "checkbox"},
        {"id": "pLastContacted", "name": "Last Contacted", "format": "date"},
