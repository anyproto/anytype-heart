      "name": "Bridesmaid Task List",
      "properties": [
        {"id": "pStatus", "name": "Status", "format": "select",
         "options": ["Not started", "In progress", "Done"]},
        {"id": "pDone", "name": "Done?", "format": "checkbox"},
        {"id": "pDueDate", "name": "Due Date", "format": "date"},
        {"id": "pAssignedTo", "name": "Assigned To", "format": "multiSelect",
         "options": ["Kat", "Priya", "Manon"]},
        {"id": "pNotes", "name": "Notes", "format": "text"}
      ],
      "titles": [
        "Book hen weekend flights",
