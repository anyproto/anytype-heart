        {"id": "pOwner", "name": "Owner", "format": "multiSelect",
         "options": ["Renata (planner)", "Best man", "Maid of honour", "Venue staff"]},
        {"id": "pLocation", "name": "Location", "format": "text"},
        {"id": "pDuration", "name": "Duration (min)", "format": "number"},
