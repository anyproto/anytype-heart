        {"id": "pSessionDate", "name": "Session Date", "format": "date"},
        {"id": "pStartTime", "name": "Start Time", "format": "text"},
        {"id": "pRoom", "name": "Room", "format": "select", "options": ["Hall A", "Hall B", "Studio 1", "Studio 2", "Atrium"]},
        {"id": "pSpeaker", "name": "Speaker", "format": "objects"},
        {"id": "pAbstract", "name": "Abstract", "format": "text"},
        {"id": "pSlidesReceived", "name": "Slides Received", "format": "checkbox"},
        {"id": "pRecordingLink", "name": "Recording Link", "format": "url"},
        {"id": "pCapacity", "name": "Capacity", "format": "number"},
        {"id": "pStatus", "name": "Status", "format": "select", "options": ["Proposed", "Accepted", "Scheduled", "Delivered", "Cancelled"]},
