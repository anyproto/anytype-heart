   }
  },
  {
   "name": "create_property",
   "description": "Create a property. Names are not identities: without an explicit key, a name a visible property already carries is refused. Supply a different available key to create another property with that name; the response carries a warning.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "format": {
      "enum": [
       "text",
       "number",
       "select",
       "multi_select",
       "date",
       "files",
       "checkbox",
       "url",
       "email",
       "phone",
       "objects"
      ],
      "type": "string"
     },
     "key": {
      "description": "the key the property is addressed by; derived from the name when omitted. Required to create another property under a display name the space already has",
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9_]+$",
      "type": "string"
     },
     "name": {
      "description": "display name. Names are not identities: without an explicit key, a name a visible property already carries is refused. Supply a different available key to create another property with that name; the response carries a warning",
      "maxLength": 4096,
      "type": "string"
     },
     "options": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "color": {
         "maxLength": 64,
         "type": "string"
        },
        "name": {
         "maxLength": 4096,
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "format",
     "name",
     "space_id"
    ],
    "type": "object"
   }
  },
