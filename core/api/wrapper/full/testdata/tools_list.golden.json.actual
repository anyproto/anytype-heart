     "blockRef": {
      "description": "a block id — full (canonical) or a unique suffix",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "op__add_property": {
      "additionalProperties": false,
      "description": "Adds one property to the type's field list; an unknown name creates it, with the given format. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries, planned and refused whole before any write, then written in order: property ops first, view ops after — a view op refused then leaves the written lists in place.",
      "properties": {
       "after": {
        "description": "place it after this property of the same section; ordering against another section changes nothing and is refused",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "place it before this property of the same section",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "format": {
        "description": "required when no property answers to the name yet, which is the case where this op creates one; on one that exists it must match the format it already has",
        "enum": [
         "text",
         "number",
         "select",
         "multi_select",
         "date",
         "files",
         "checkbox",
         "url",
         "email",
         "phone",
         "objects"
        ],
        "type": "string"
       },
       "op": {
        "const": "add_property"
       },
       "options": {
        "description": "select and multi_select only: the option names the property may take. Creating one needs create_missing_options=true.",
        "items": {
         "additionalProperties": false,
         "properties": {
          "color": {
           "maxLength": 64,
           "type": "string"
          },
          "name": {
           "maxLength": 4096,
           "type": "string"
          }
         },
         "required": [
          "name"
         ],
         "type": "object"
        },
        "maxItems": 100,
        "type": "array"
       },
       "position": {
        "description": "at most one of after, before and position; first makes this the leading field of its section",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "property": {
        "description": "the property, by the key list_properties serves or by its display name. A name nothing answers to creates the property, which is what format is for. To rename a property send {name} to update_property; do not re-send property_definitions.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "section": {
        "description": "featured shows the property at the top of an object, hidden keeps it off the object entirely. Null is the plain field list. Omitted leaves a property already on the type where it is.",
        "enum": [
         "featured",
         "hidden",
         null
        ],
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "op",
       "property"
      ],
      "type": "object"
     },
     "op__delete_view": {
      "additionalProperties": false,
      "description": "Deletes a view from the dataview; the last one is refused. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "op": {
        "const": "delete_view"
       },
       "view": {
        "description": "the view to delete (id, full or unique suffix) — deleting the last view is refused; per-view editor state goes with it",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "view"
      ],
      "type": "object"
     },
     "op__insert_view": {
      "additionalProperties": false,
      "description": "Adds a view to the object's dataview, with defaults or copied from another. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "after": {
        "description": "insert after this view (id, full or unique suffix)",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "insert before this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "columns": {
        "additionalProperties": {
         "additionalProperties": false,
         "properties": {
          "aggregation": {
           "enum": [
            "count",
            "count_value",
            "count_distinct",
            "count_empty",
            "count_not_empty",
            "percent_empty",
            "percent_not_empty",
            "sum",
            "average",
            "median",
            "min",
            "max",
            "range",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "align": {
           "enum": [
            "left",
            "center",
            "right",
            "justify",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "hidden": {
           "description": "omitted/false = visible",
           "type": [
            "boolean",
            "null"
           ]
          },
          "width": {
           "description": "pixels; null/omitted lets the client pick per format",
           "maximum": 10000,
           "minimum": 0,
           "type": [
            "integer",
            "null"
           ]
          }
         },
         "type": [
          "object",
          "null"
         ]
        },
        "description": "per-column patches keyed by property key: each merges into that property's column (appending one if absent); null removes the column; unnamed columns are untouched — never resend the whole column list",
        "maxProperties": 64,
        "type": "object"
       },
       "copy_from": {
        "description": "duplicate this view of the same dataview, everything but its id and name, then apply set and columns on top. Omitted: defaults, every listed property visible, sorted by last_modified_date desc.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "description": "the new view's name (its tab label)",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "insert_view"
       },
       "position": {
        "description": "at most one of after/before/position; omitted = append; the FIRST view is the client's default tab",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "set": {
        "additionalProperties": false,
        "description": "merge: only the named fields change, null clears one to its default. sorts and filters replace whole. filter is the compact-string alternative to filters; never both. Columns use the columns channel.",
        "maxProperties": 17,
        "properties": {
         "alternate_rows": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "card_size": {
          "enum": [
           "small",
           "medium",
           "large",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "colored_groups": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_fit": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_template_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_type_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "end_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "filter": {
          "description": "compact filter syntax (schema kind filters serves the grammar); parsed server-side into filters",
          "maxLength": 4096,
          "type": "string"
         },
         "filters": {
          "description": "filter nodes (schema kind filters), at most 32 at the top level (group more under and/or nodes) — recursive, so prefer filter, the compact string",
          "items": {
           "$ref": "#/$defs/anyValue"
          },
          "maxItems": 32,
          "type": [
           "array",
           "null"
          ]
         },
         "group_by": {
          "description": "property key to group by (kanban/board views)",
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "hide_icon": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "list_size": {
          "enum": [
           "compact",
           "regular",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "page_size": {
          "maximum": 1000,
          "minimum": 0,
          "type": [
           "integer",
           "null"
          ]
         },
         "sorts": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "custom_order": {
             "items": {
              "$ref": "#/$defs/anyValue"
             },
             "maxItems": 128,
             "type": "array"
            },
            "direction": {
             "enum": [
              "asc",
              "desc",
              "custom"
             ],
             "type": "string"
            },
            "empty_placement": {
             "enum": [
              "start",
              "end"
             ],
             "type": "string"
            },
            "id": {
             "description": "output-only on reads; accepted back so a read sort round-trips",
             "maxLength": 64,
             "type": "string"
            },
            "include_time": {
             "type": "boolean"
            },
            "no_collate": {
             "type": "boolean"
            },
            "property": {
             "maxLength": 256,
             "type": "string"
            }
           },
           "required": [
            "property"
           ],
           "type": "object"
          },
          "maxItems": 10,
          "type": [
           "array",
           "null"
          ]
         },
         "type": {
          "enum": [
           "table",
           "list",
           "gallery",
           "kanban",
           "calendar",
           "graph",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "wrap_content": {
          "type": [
           "boolean",
           "null"
          ]
         }
        },
        "type": "object"
       }
      },
      "required": [
       "op",
       "name"
      ],
      "type": "object"
     },
     "op__move_property": {
      "additionalProperties": false,
      "description": "Reorders one property within its section of the type. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries, planned and refused whole before any write, then written in order: property ops first, view ops after — a view op refused then leaves the written lists in place.",
      "properties": {
       "after": {
        "description": "place it after this property of the same section; ordering against another section changes nothing and is refused",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "place it before this property of the same section",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "move_property"
       },
       "position": {
        "description": "give exactly one of after, before or position. first makes this the type's leading field, within the section it sits in.",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "property": {
        "description": "the property to move, by the key list_properties serves or by its display name. This reorders within a section; add_property with section moves it between sections.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "property"
      ],
      "type": "object"
     },
     "op__move_view": {
      "additionalProperties": false,
      "description": "Reorders a view among the dataview's views. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "after": {
        "description": "move after this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "move before this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "op": {
        "const": "move_view"
       },
       "position": {
        "description": "give exactly one of after/before/position — a destination is required; first makes the view the client's default tab",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "view": {
        "description": "the view to move (id, full or unique suffix)",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "view"
      ],
      "type": "object"
     },
     "op__remove_property": {
      "additionalProperties": false,
      "description": "Takes one property off the type's field list; the property and its values stay in the space. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries, planned and refused whole before any write, then written in order: property ops first, view ops after — a view op refused then leaves the written lists in place.",
      "properties": {
       "op": {
        "const": "remove_property"
       },
       "property": {
        "description": "the property to take off this type, by the key list_properties serves or by its display name. A property this type does not list is refused, never ignored. The property itself stays in the space with its values; only this type stops declaring it.",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "property"
      ],
      "type": "object"
     },
     "op__update_view": {
      "additionalProperties": false,
      "description": "Changes a view's fields or columns on the object's dataview. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "columns": {
        "additionalProperties": {
         "additionalProperties": false,
         "properties": {
          "aggregation": {
           "enum": [
            "count",
            "count_value",
            "count_distinct",
            "count_empty",
            "count_not_empty",
            "percent_empty",
            "percent_not_empty",
            "sum",
            "average",
            "median",
            "min",
            "max",
            "range",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "align": {
           "enum": [
            "left",
            "center",
            "right",
            "justify",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "hidden": {
           "description": "omitted/false = visible",
           "type": [
            "boolean",
            "null"
           ]
          },
          "width": {
           "description": "pixels; null/omitted lets the client pick per format",
           "maximum": 10000,
           "minimum": 0,
           "type": [
            "integer",
            "null"
           ]
          }
         },
         "type": [
          "object",
          "null"
         ]
        },
        "description": "per-column patches keyed by property key: each merges into that property's column (appending one if absent); null removes the column; unnamed columns are untouched — never resend the whole column list",
        "maxProperties": 64,
        "type": "object"
       },
       "op": {
        "const": "update_view"
       },
       "set": {
        "additionalProperties": false,
        "description": "merge: only the named fields change, null clears one to its default. sorts and filters replace whole. filter is the compact-string alternative to filters; never both. Columns use the columns channel.",
        "maxProperties": 18,
        "properties": {
         "alternate_rows": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "card_size": {
          "enum": [
           "small",
           "medium",
           "large",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "colored_groups": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_fit": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_template_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_type_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "end_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "filter": {
          "description": "compact filter syntax (schema kind filters serves the grammar); parsed server-side into filters",
          "maxLength": 4096,
          "type": "string"
         },
         "filters": {
          "description": "filter nodes (schema kind filters), at most 32 at the top level (group more under and/or nodes) — recursive, so prefer filter, the compact string",
          "items": {
           "$ref": "#/$defs/anyValue"
          },
          "maxItems": 32,
          "type": [
           "array",
           "null"
          ]
         },
         "group_by": {
          "description": "property key to group by (kanban/board views)",
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "hide_icon": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "list_size": {
          "enum": [
           "compact",
           "regular",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "name": {
          "maxLength": 4096,
          "type": [
           "string",
           "null"
          ]
         },
         "page_size": {
          "maximum": 1000,
          "minimum": 0,
          "type": [
           "integer",
           "null"
          ]
         },
         "sorts": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "custom_order": {
             "items": {
              "$ref": "#/$defs/anyValue"
             },
             "maxItems": 128,
             "type": "array"
            },
            "direction": {
             "enum": [
              "asc",
              "desc",
              "custom"
             ],
             "type": "string"
            },
            "empty_placement": {
             "enum": [
              "start",
              "end"
             ],
             "type": "string"
            },
            "id": {
             "description": "output-only on reads; accepted back so a read sort round-trips",
             "maxLength": 64,
             "type": "string"
            },
            "include_time": {
             "type": "boolean"
            },
            "no_collate": {
             "type": "boolean"
            },
            "property": {
             "maxLength": 256,
             "type": "string"
            }
           },
           "required": [
            "property"
           ],
           "type": "object"
          },
          "maxItems": 10,
          "type": [
           "array",
           "null"
          ]
         },
         "type": {
          "enum": [
           "table",
           "list",
           "gallery",
           "kanban",
           "calendar",
           "graph",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "wrap_content": {
          "type": [
           "boolean",
           "null"
          ]
         }
        },
        "type": "object"
       },
       "view": {
        "description": "view id, full or unique suffix — optional when the dataview has exactly one view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op"
      ],
      "type": "object"
     }
    }
   },
   "annotations": {
    "destructiveHint": true
   }
  },
  {
   "name": "delete_type",
   "description": "Delete a type",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "type": {
      "description": "Type key",
      "type": "string"
     }
    },
    "required": [
     "space_id",
     "type"
    ],
    "type": "object"
   },
   "annotations": {
    "destructiveHint": true
   }
  },
  {
   "name": "list_widgets",
   "description": "List widgets. The sidebar in its order: the space widgets every member sees, then this account's personal ones. `scope` narrows to one of the two. A built-in listing is a target spelled with a leading underscore, such as _favorite or _bin; an object id is served as it is.",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "scope": {
      "description": "space or personal; omitted lists both",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_widget",
   "description": "Create a widget. Adds a widget for an object to the space sidebar (scope space, owner and admins) or to this account's own (scope personal, any member who can write). One widget per target per scope. The layout and limit follow the app's own rules: a layout the target cannot render, or a limit off the app's list, is replaced with the app's fallback and reported in warnings.",
   "inputSchema": {
    "allOf": [
     {
      "not": {
       "required": [
        "after",
        "before"
       ]
      }
     },
     {
      "not": {
       "required": [
        "after",
        "position"
       ]
      }
     },
     {
      "not": {
       "required": [
        "before",
        "position"
       ]
      }
     }
    ],
    "properties": {
     "after": {
      "description": "id or target of the sidebar widget to place this one after. At most one of after, before and position; on PATCH, none of the three keeps the position",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "before": {
      "description": "id or target of the sidebar widget to place this one before",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "layout": {
      "description": "how the widget renders. Omitted on POST, the target's kind picks it: tree for a page, view for a query, collection or type, link for everything else. A layout the target cannot render is replaced with the one it can, with a warning",
      "enum": [
       "link",
       "tree",
       "list",
       "compact_list",
       "view"
      ],
      "type": "string"
     },
     "limit": {
      "description": "how many entries a listing shows, from the app's own pick-list: 6, 10, 14, 30 or 50, or 4, 6, 8, 30, 50 for the list layout; any other value is stored as the smallest, with a warning. Omitted on POST, the smallest; omitted on PATCH, the stored limit stays unless a new layout's list lacks it. Not taken by link",
      "type": "integer"
     },
     "position": {
      "description": "first or last in the sidebar, last meaning before the bin widget when that is last; omitted with no after or before, a POST goes last",
      "enum": [
       "first",
       "last"
      ],
      "type": "string"
     },
     "scope": {
      "description": "space is the sidebar every member sees, written by the owner and admins; personal is this account's own sidebar in the space. Required on POST",
      "enum": [
       "space",
       "personal"
      ],
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "target": {
      "description": "id of the object the widget points at. Required on POST, refused on PATCH. Built-in listings cannot be added",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "view_id": {
      "description": "which of the target's views a view widget shows. Only a query, collection or type target has views, and only a space widget keeps one",
      "maxLength": 256,
      "type": "string"
     }
    },
    "required": [
     "scope",
     "space_id",
     "target"
    ],
    "type": "object"
   }
  },
  {
   "name": "update_widget",
   "description": "Update a widget. Changes the layout, the limit or the view of a widget, or moves it with after, before or position. The path names the widget by its id or by its target; a target the sidebar holds in both scopes needs `scope`. The target itself does not change: delete the widget and create one for the other object.",
   "inputSchema": {
    "allOf": [
     {
      "not": {
       "required": [
        "after",
        "before"
       ]
      }
     },
     {
      "not": {
       "required": [
        "after",
        "position"
       ]
      }
     },
     {
      "not": {
       "required": [
        "before",
        "position"
       ]
      }
     }
    ],
    "minProperties": 1,
    "properties": {
     "after": {
      "description": "id or target of the sidebar widget to move this one after. At most one of after, before and position; omitted, the widget keeps its position",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "before": {
      "description": "id or target of the sidebar widget to move this one before",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "layout": {
      "description": "link, tree, list, compact_list or view. The layout and the limit are re-validated as a pair whenever either is sent: a layout the target cannot render is replaced with the one it can, with a warning, and a stored layout the target cannot render is replaced the same way on a limit change",
      "enum": [
       "link",
       "tree",
       "list",
       "compact_list",
       "view"
      ],
      "type": "string"
     },
     "limit": {
      "description": "how many entries a listing shows, from the app's own pick-list: 6, 10, 14, 30 or 50, or 4, 6, 8, 30, 50 for the list layout; any other value is stored as the smallest, with a warning. Omitted, the stored limit stays, re-fitted to the list of a new layout when that list does not hold it. With the link layout the stored limit stays untouched and a sent one is not stored",
      "type": "integer"
     },
     "position": {
      "description": "first or last in the sidebar, last meaning before the bin widget when that is last",
      "enum": [
       "first",
       "last"
      ],
      "type": "string"
     },
     "scope": {
      "description": "space or personal, when the target is in both",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "view_id": {
      "description": "which of the target's views a view widget shows, by view id; an empty string returns to the target's first view. Only a query, collection or type target has views, and only a space widget keeps one",
      "maxLength": 256,
      "type": "string"
     },
     "widget_id": {
      "description": "Widget id, or the id of the object the widget points at",
      "type": "string"
     }
    },
    "required": [
     "space_id",
     "widget_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "delete_widget",
   "description": "Delete a widget. Removes the widget from its sidebar. The object it pointed at is untouched. The path names the widget by its id or by its target; a target the sidebar holds in both scopes needs `scope`.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Report without removing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key replays the stored response",
      "type": "string"
     },
     "scope": {
      "description": "space or personal, when the target is in both",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "widget_id": {
      "description": "Widget id, or the id of the object the widget points at",
      "type": "string"
     }
    },
    "required": [
     "space_id",
     "widget_id"
    ],
    "type": "object"
   },
   "annotations": {
    "destructiveHint": true
   }
  },
  {
   "name": "validate",
   "description": "Validate an AnyBlock document. Structure and format rules only. Nothing is resolved against a space, so option names and a type's property keys are not checked here. Findings come back as data: an invalid document is still a 200, carrying the issues, and a valid one carries empty lists. Body: an AnyBlock document of any kind, checked without being stored; its schema and a worked example come from get_schema with kind document.",
   "inputSchema": {
    "properties": {
     "idempotency_key": {
      "description": "Retry key; identical requests replay, different requests conflict",
      "type": "string"
     }
    },
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  }
 ]
}