                 "maxLength": 1048576,
                 "type": "string"
                },
                {
                 "type": "number"
                },
                {
                 "type": "boolean"
                },
                {
                 "type": "null"
                }
               ]
              },
              "maxItems": 2048,
              "type": "array"
             },
             {
              "additionalProperties": {
               "oneOf": [
                {
                 "maxLength": 1048576,
                 "type": "string"
                },
                {
                 "type": "number"
                },
                {
                 "type": "boolean"
                },
                {
                 "type": "null"
                }
               ]
              },
              "maxProperties": 128,
              "type": "object"
             }
            ]
           },
           "maxItems": 2048,
           "type": "array"
          },
          {
           "additionalProperties": {
            "oneOf": [
             {
              "maxLength": 1048576,
              "type": "string"
             },
             {
              "type": "number"
             },
             {
              "type": "boolean"
             },
             {
              "type": "null"
             },
             {
              "items": {
               "oneOf": [
                {
                 "maxLength": 1048576,
                 "type": "string"
                },
                {
                 "type": "number"
                },
                {
                 "type": "boolean"
                },
                {
                 "type": "null"
                }
               ]
              },
              "maxItems": 2048,
              "type": "array"
             },
             {
              "additionalProperties": {
               "oneOf": [
                {
                 "maxLength": 1048576,
                 "type": "string"
                },
                {
                 "type": "number"
                },
                {
                 "type": "boolean"
                },
                {
                 "type": "null"
                }
               ]
              },
              "maxProperties": 128,
              "type": "object"
             }
            ]
           },
           "maxProperties": 128,
           "type": "object"
          }
         ]
        },
        "maxProperties": 128,
        "type": "object"
       }
      ]
     },
     "FilterNode": {
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "filters": {
          "items": {
           "$ref": "#/$defs/FilterNode"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
         },
         "operator": {
          "enum": [
           "and",
           "or"
          ],
          "type": "string"
         }
        },
        "required": [
         "operator",
         "filters"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "condition": {
          "enum": [
           "equal",
           "not_equal",
           "greater",
           "less",
           "greater_or_equal",
           "less_or_equal",
           "contains",
           "not_contains",
           "in",
           "not_in",
           "empty",
           "not_empty",
           "all_in",
           "not_all_in",
           "exact_in",
           "not_exact_in",
           "exists"
          ],
          "type": "string"
         },
         "date_preset": {
          "enum": [
           "yesterday",
           "today",
           "tomorrow",
           "last_week",
           "current_week",
           "next_week",
           "last_month",
           "current_month",
           "next_month",
           "number_of_days_ago",
           "number_of_days_now",
           "last_year",
           "current_year",
           "next_year"
          ],
          "type": "string"
         },
         "include_time": {
          "type": "boolean"
         },
         "property": {
          "maxLength": 256,
          "type": "string"
         },
         "value": {
          "description": "leaf value. A select or multi_select takes option names, never ids. A date takes unix seconds; where the filter is stored (a query's views, update_view) it also takes a date string such as 2026-08-01 or 2026-08-01T09:00:00Z, converted on write, while search takes a date string only in the compact filter string"
         }
        },
        "required": [
         "property",
         "condition"
        ],
        "type": "object"
       }
      ]
     }
    }
   }
  },
  {
   "name": "get_query_objects",
   "description": "List query results. Without view, the query's first stored view applies, so its filters and sorts shape the rows; when the query has several views a warning names the one applied and the others. A view's dynamic placeholders, such as the calling member, are resolved here; one that cannot be resolved becomes a warning rather than a silently empty result.",
   "inputSchema": {
    "properties": {
     "fields": {
      "description": "Comma-separated property keys to include per row",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "query_id": {
      "description": "Query object id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "view": {
      "description": "Stored view id (exact or unique suffix). Omitted, the query's first view applies.",
      "type": "string"
     }
    },
    "required": [
     "query_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "get_query_views",
   "description": "List query views",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "query_id": {
      "description": "Query object id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "query_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "search_space",
   "description": "Search objects in a space. `filter` and `filters` are two spellings of the same thing, the compact string and the structured array; sending both is refused. This is a read carried by POST because the query needs a body, so pagination stays in the query string and a `limit` or `offset` in the body is refused.",
   "inputSchema": {
    "properties": {
     "fields": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "uniqueItems": false
     },
     "filter": {
      "type": "string"
     },
     "filters": {
      "items": {
       "additionalProperties": {},
       "type": "object"
      },
      "type": "array",
      "uniqueItems": false
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "query": {
      "description": "Full-text query over object names and indexed content.",
      "type": "string"
     },
     "sorts": {
      "items": {
       "additionalProperties": {},
       "type": "object"
      },
      "type": "array",
      "uniqueItems": false
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "list_templates",
   "description": "List templates. `type` narrows the list to the templates of one type. Each row's id is what a create passes in `template`, and `default` marks the one a create of that type starts from on its own.",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "type": {
      "description": "Type key: list only the templates that start an object of this type",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_template",
   "description": "Create a template. `template_for` names the type key this template starts an object of. Body: the template as an AnyBlock document: formatVersion 2.0, kind template, template_for naming the type; its schema and a worked example come from get_schema with kind template.",
   "inputSchema": {
    "properties": {
     "create_missing_options": {
      "description": "Create select options for names the property does not hold yet (default false: an unmatched name is refused)",
      "type": "boolean"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "list_types",
   "description": "List types",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_type",
   "description": "Create a type. A `property_definitions` entry naming a property that does not exist creates it alongside the type. The body is either the flat type body or an AnyBlock document with kind \"object_type\"; `formatVersion`, `kind` or `type_settings` picks the document form. Body: the flat type body, or the interchange document with kind object_type.",
   "inputSchema": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "the body POST takes. PATCH takes the same members, all optional, except api_key, which is create-only",
      "properties": {
       "api_key": {},
       "create_missing_options": {},
       "default_template": {},
       "default_view": {},
       "dry_run": {},
       "icon": {},
       "layout": {},
       "name": {},
       "plural_name": {},
       "property_definitions": {},
       "space_id": {}
      },
      "required": [
       "name"
      ]
     },
     {
      "description": "the type as an AnyBlock document: formatVersion 2.0, kind object_type, the definition under type_settings; its schema and a worked example come from get_schema with kind type_document",
      "properties": {
       "create_missing_options": {},
       "dry_run": {},
       "space_id": {}
      }
     }
    ],
    "description": "the flat type body, or the interchange document with kind object_type",
    "properties": {
     "api_key": {
      "description": "the key object bodies name this type by; derived from the name when omitted",
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9_]+$",
      "type": "string"
     },
     "create_missing_options": {
      "description": "Create select options for names the property does not hold yet (default false: an unmatched name is refused)",
      "type": "boolean"
     },
     "default_template": {
      "description": "id of the template new objects of this type start from unless the create names its own or sends none; empty string clears it",
      "maxLength": 256,
      "type": "string"
     },
     "default_view": {
      "description": "how a set or collection of this type opens; applies to ones created after the change",
      "enum": [
       "table",
       "list",
       "gallery",
       "kanban",
       "calendar",
       "graph"
      ],
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "icon": {
      "additionalProperties": false,
      "description": "give format plus its own member: emoji, name or file",
      "oneOf": [
       {
        "properties": {
         "format": {
          "const": "emoji"
         }
        },
        "required": [
         "format",
         "emoji"
        ]
       },
       {
        "properties": {
         "format": {
          "const": "icon"
         }
        },
        "required": [
         "format",
         "name"
        ]
       },
       {
        "properties": {
         "format": {
          "const": "file"
         }
        },
        "required": [
         "format",
         "file"
        ]
       }
      ],
      "properties": {
       "color": {
        "enum": [
         "grey",
         "yellow",
         "orange",
         "red",
         "pink",
         "purple",
         "blue",
         "ice",
         "teal",
         "lime"
        ],
        "type": "string"
       },
       "emoji": {
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
       },
       "file": {
        "description": "id of an image object in this space, with format file",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "format": {
        "enum": [
         "emoji",
         "icon",
         "file"
        ],
        "type": "string"
       },
       "name": {
        "description": "a built-in icon name, with format icon",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "layout": {
      "description": "the layout instances of this type get; basic unless you need another",
      "enum": [
       "basic",
       "note",
       "todo",
       "profile",
       "bookmark",
       "set",
       "collection"
      ],
      "type": "string"
     },
     "name": {
      "description": "display name, singular. Required on POST; on PATCH send it only to rename",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     },
     "plural_name": {
      "maxLength": 4096,
      "type": "string"
     },
     "property_definitions": {
      "description": "the type's whole field list; an unknown name mints a property. On PATCH it replaces the list, so to change one field send an ops envelope with add_property to update_type instead, and to rename a property send {name} to update_property",
      "items": {
       "additionalProperties": false,
       "description": "names its property by name or by property, one of the two",
       "properties": {
        "format": {
         "description": "the new property's format; omit it and an unknown name is created as text",
         "enum": [
          "text",
          "number",
          "select",
          "multi_select",
          "date",
          "files",
          "checkbox",
          "url",
          "email",
          "phone",
          "objects"
         ],
         "type": "string"
        },
        "name": {
         "description": "the property's display name, e.g. Due date; an unknown one is created",
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "options": {
         "description": "select and multi_select only: the option vocabulary; creating options here needs the create_missing_options parameter set to true",
         "items": {
          "additionalProperties": false,
          "properties": {
           "color": {
            "maxLength": 64,
            "type": "string"
           },
           "name": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "name"
          ],
          "type": "object"
         },
         "maxItems": 100,
         "type": "array"
        },
        "property": {
         "description": "the property by the key the space serves, for one that exists",
         "maxLength": 256,
         "minLength": 1,
         "type": "string"
        },
        "section": {
         "description": "featured shows the property on the object itself",
         "enum": [
          "featured",
          "hidden"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 128,
      "type": "array"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "get_type",
   "description": "Get a type",
   "inputSchema": {
    "properties": {
     "ids": {
      "description": "compact (default) is the edit shape, with short labels for minted view and block ids; full is the export shape, with full ids",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "type": {
      "description": "Type key",
      "type": "string"
     }
    },
    "required": [
     "space_id",
     "type"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "update_type",
   "description": "Update a type. Takes an ops envelope or the type body. Ops add, remove and reorder one property at a time; a removal also drops its column from the views, except any view that groups, covers, sorts or filters by it. In the body, `property_definitions` replaces the whole field list rather than adding to it, and names under `removed` whatever that detached. `api_key` is create-only. Body: the flat type body with the fields to change, a partial type document, or an ops envelope that edits the property list and the views one op at a time.",
   "inputSchema": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "the flat body, every member optional; at least one",
      "properties": {
       "create_missing_options": {},
       "default_template": {},
       "default_view": {},
       "dry_run": {},
       "icon": {},
       "if_match": {},
       "layout": {},
       "name": {},
       "plural_name": {},
       "property_definitions": {},
       "space_id": {},
       "type": {}
      }
     },
     {
      "additionalProperties": false,
      "description": "a partial type document: properties carries the type's own details, type_settings the settings to change",
      "properties": {
       "create_missing_options": {},
       "dry_run": {},
       "icon": {},
       "if_match": {},
       "properties": {},
       "space_id": {},
       "type": {},
       "type_settings": {}
      }
     },
     {
      "additionalProperties": false,
      "properties": {
       "create_missing_options": {},
       "dry_run": {},
       "if_match": {},
       "ops": {},
       "space_id": {},
       "type": {}
      },
      "required": [
       "ops"
      ]
     }
    ],
