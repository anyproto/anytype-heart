            "additionalProperties": {
             "$ref": "#/$defs/anyValue"
            },
            "description": "a cell: a string (paragraph shorthand), null (empty), a block object, or a flat array whose first element is the cell block. a cell block takes no id; blocks inside follow the payload block's id rule.",
            "items": {
             "$ref": "#/$defs/anyValue"
            },
            "maxItems": 2048,
            "maxLength": 1048576,
            "maxProperties": 128,
            "type": [
             "string",
             "null",
             "object",
             "array"
            ]
           },
           "maxItems": 64,
           "type": "array"
          },
          "id": {
           "description": "optional; names an existing row or column (full id or unique suffix) and keeps its identity. Omit it to author a new one: the server mints the id into created_blocks under this payload path.",
           "maxLength": 1048576,
           "pattern": "^[A-Za-z0-9_]{1,64}$",
           "type": "string"
          },
          "is_header": {
           "type": "boolean"
          }
         },
         "type": "object"
        },
        "maxItems": 1024,
        "type": "array"
       },
       "style": {
        "maxLength": 64,
        "type": "string"
       },
       "text": {
        "description": "inline markup source",
        "maxLength": 1048576,
        "type": "string"
       },
       "type": {
        "enum": [
         "paragraph",
         "heading_1",
         "heading_2",
         "heading_3",
         "heading_4",
         "header_4",
         "quote",
         "code",
         "checkbox",
         "bulleted_list_item",
         "numbered_list_item",
         "toggle",
         "callout",
         "toggle_heading_1",
         "toggle_heading_2",
         "toggle_heading_3",
         "file",
         "image",
         "video",
         "audio",
         "pdf",
         "bookmark",
         "link",
         "divider",
         "row",
         "column",
         "table",
         "embed",
         "equation",
         "table_of_contents",
         "property",
         "dataview",
         "widget",
         "chat",
         "icon"
        ],
        "type": "string"
       },
       "url": {
        "maxLength": 4096,
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "op__add_items": {
      "additionalProperties": false,
      "description": "Adds objects to the collection, by id. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "items": {
        "description": "member object ids to add to the collection (already-present ids are ignored)",
        "items": {
         "maxLength": 256,
         "type": "string"
        },
        "maxItems": 1000,
        "minItems": 1,
        "type": "array"
       },
       "op": {
        "const": "add_items"
       }
      },
      "required": [
       "op",
       "items"
      ],
      "type": "object"
     },
     "op__delete_block": {
      "additionalProperties": false,
      "description": "Deletes a childless block found by id or by its text, or its whole subtree with recursive set to true. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "id": {
        "$ref": "#/$defs/blockRef",
        "description": "the block to delete — give this or match, never both"
       },
       "match": {
        "description": "alternative to id: exact text from the block, markdown markup included. Must match exactly one block (repeats in it are fine); several are refused with candidate ids. Give id or match, never both.",
        "maxLength": 65536,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "delete_block"
       },
       "recursive": {
        "description": "default false — deleting a block that has descendants without it is an error naming the descendant count and the resolved block id",
        "type": "boolean"
       }
      },
      "required": [
       "op"
      ],
      "type": "object"
     },
     "op__delete_view": {
      "additionalProperties": false,
      "description": "Deletes a view from the dataview; the last one is refused. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "op": {
        "const": "delete_view"
       },
       "view": {
        "description": "the view to delete (id, full or unique suffix) — deleting the last view is refused; per-view editor state goes with it",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "view"
      ],
      "type": "object"
     },
     "op__insert_blocks": {
      "additionalProperties": false,
      "description": "Inserts new blocks or markdown after, before or inside a block, or at either end of the document. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "after": {
        "$ref": "#/$defs/blockRef",
        "description": "insert after this block's subtree, at its level"
       },
       "before": {
        "$ref": "#/$defs/blockRef",
        "description": "insert before this block, at its level"
       },
       "blocks": {
        "description": "at most one of after/before/inside targets the run — omit all three to insert at the end of the document (position:first for the start; both work on an empty object); indent 0 = the insertion level",
        "items": {
         "$ref": "#/$defs/block__insert_blocks"
        },
        "maxItems": 256,
        "minItems": 1,
        "type": "array"
       },
       "inside": {
        "$ref": "#/$defs/blockRef",
        "description": "insert as children of this block"
       },
       "markdown": {
        "description": "alternative to blocks; give exactly one. Parsed into flat blocks (headings, lists, checkboxes, fences, quotes, dividers, tables), at most 256. created_blocks keys read ops[i].markdown[j].",
        "maxLength": 1048576,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "insert_blocks"
       },
       "position": {
        "description": "which end to insert at: of the inside container, or of the document itself when no targeting field is given. Refused with after/before. first goes to the start, last appends (the default either way).",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       }
      },
      "required": [
       "op"
      ],
      "type": "object"
     },
     "op__insert_view": {
      "additionalProperties": false,
      "description": "Adds a view to the object's dataview, with defaults or copied from another. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "after": {
        "description": "insert after this view (id, full or unique suffix)",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "insert before this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "columns": {
        "additionalProperties": {
         "additionalProperties": false,
         "properties": {
          "aggregation": {
           "enum": [
            "count",
            "count_value",
            "count_distinct",
            "count_empty",
            "count_not_empty",
            "percent_empty",
            "percent_not_empty",
            "sum",
            "average",
            "median",
            "min",
            "max",
            "range",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "align": {
           "enum": [
            "left",
            "center",
            "right",
            "justify",
            null
           ],
           "type": [
            "string",
            "null"
           ]
          },
          "hidden": {
           "description": "omitted/false = visible",
           "type": [
            "boolean",
            "null"
           ]
          },
          "width": {
           "description": "pixels; null/omitted lets the client pick per format",
           "maximum": 10000,
           "minimum": 0,
           "type": [
            "integer",
            "null"
           ]
          }
         },
         "type": [
          "object",
          "null"
         ]
        },
        "description": "per-column patches keyed by property key: each merges into that property's column (appending one if absent); null removes the column; unnamed columns are untouched — never resend the whole column list",
        "maxProperties": 64,
        "type": "object"
       },
       "copy_from": {
        "description": "duplicate this view of the same dataview, everything but its id and name, then apply set and columns on top. Omitted: defaults, every listed property visible, sorted by last_modified_date desc.",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "description": "the new view's name (its tab label)",
        "maxLength": 4096,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "insert_view"
       },
       "position": {
        "description": "at most one of after/before/position; omitted = append; the FIRST view is the client's default tab",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "set": {
        "additionalProperties": false,
        "description": "merge: only the named fields change, null clears one to its default. sorts and filters replace whole. filter is the compact-string alternative to filters; never both. Columns use the columns channel.",
        "maxProperties": 17,
        "properties": {
         "alternate_rows": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "card_size": {
          "enum": [
           "small",
           "medium",
           "large",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "colored_groups": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_fit": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "cover_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_template_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "default_type_id": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "end_property": {
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "filter": {
          "description": "compact filter syntax (schema kind filters serves the grammar); parsed server-side into filters",
          "maxLength": 4096,
          "type": "string"
         },
         "filters": {
          "description": "filter nodes (schema kind filters), at most 32 at the top level (group more under and/or nodes) — recursive, so prefer filter, the compact string",
          "items": {
           "$ref": "#/$defs/anyValue"
          },
          "maxItems": 32,
          "type": [
           "array",
           "null"
          ]
         },
         "group_by": {
          "description": "property key to group by (kanban/board views)",
          "maxLength": 256,
          "type": [
           "string",
           "null"
          ]
         },
         "hide_icon": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "list_size": {
          "enum": [
           "compact",
           "regular",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "page_size": {
          "maximum": 1000,
          "minimum": 0,
          "type": [
           "integer",
           "null"
          ]
         },
         "sorts": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "custom_order": {
             "items": {
              "$ref": "#/$defs/anyValue"
             },
             "maxItems": 128,
             "type": "array"
            },
            "direction": {
             "enum": [
              "asc",
              "desc",
              "custom"
             ],
             "type": "string"
            },
            "empty_placement": {
             "enum": [
              "start",
              "end"
             ],
             "type": "string"
            },
            "id": {
             "description": "output-only on reads; accepted back so a read sort round-trips",
             "maxLength": 64,
             "type": "string"
            },
            "include_time": {
             "type": "boolean"
            },
            "no_collate": {
             "type": "boolean"
            },
            "property": {
             "maxLength": 256,
             "type": "string"
            }
           },
           "required": [
            "property"
           ],
           "type": "object"
          },
          "maxItems": 10,
          "type": [
           "array",
           "null"
          ]
         },
         "type": {
          "enum": [
           "table",
           "list",
           "gallery",
           "kanban",
           "calendar",
           "graph",
           null
          ],
          "type": [
           "string",
           "null"
          ]
         },
         "wrap_content": {
          "type": [
           "boolean",
           "null"
          ]
         }
        },
        "type": "object"
       }
      },
      "required": [
       "op",
       "name"
      ],
      "type": "object"
     },
     "op__move_block": {
      "additionalProperties": false,
      "description": "Moves a block and its subtree to a new place. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "after": {
        "$ref": "#/$defs/blockRef"
       },
       "before": {
        "$ref": "#/$defs/blockRef"
       },
       "id": {
        "$ref": "#/$defs/blockRef",
        "description": "the block to move — its whole subtree moves with it; omit after/before/inside to move it to the end of the document (position:first for the start)"
       },
       "inside": {
        "$ref": "#/$defs/blockRef",
        "description": "moving into the moved block's own subtree is a cycle → error"
       },
       "op": {
        "const": "move_block"
       },
       "position": {
        "description": "which end to move to: of the inside container, or — with NO targeting field — of the document itself, so first moves the block to the start of the document and last to its end (the default either way)",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       }
      },
      "required": [
       "op",
       "id"
      ],
      "type": "object"
     },
     "op__move_view": {
      "additionalProperties": false,
      "description": "Reorders a view among the dataview's views. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied. On a type, property ops are written first; a view op refused after that leaves them written.",
      "properties": {
       "after": {
        "description": "move after this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "before": {
        "description": "move before this view",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "block": {
        "$ref": "#/$defs/blockRef",
        "description": "a dataview block — optional when the object has exactly one (types, queries and collections do)"
       },
       "op": {
        "const": "move_view"
       },
       "position": {
        "description": "give exactly one of after/before/position — a destination is required; first makes the view the client's default tab",
        "enum": [
         "first",
         "last"
        ],
        "type": "string"
       },
       "view": {
        "description": "the view to move (id, full or unique suffix)",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "view"
      ],
      "type": "object"
     },
     "op__remove_items": {
      "additionalProperties": false,
      "description": "Removes objects from the collection, by id. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "items": {
        "description": "member object ids to remove from the collection (absent ids are ignored)",
        "items": {
         "maxLength": 256,
         "type": "string"
        },
        "maxItems": 1000,
        "minItems": 1,
        "type": "array"
       },
       "op": {
        "const": "remove_items"
       }
      },
      "required": [
       "op",
       "items"
      ],
      "type": "object"
     },
     "op__replace_subtree": {
      "additionalProperties": false,
      "description": "Replaces one block and its descendants with new blocks. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "blocks": {
        "description": "replaces the block AND its descendants; indent 0 = the replaced block's level",
        "items": {
         "$ref": "#/$defs/block__replace_subtree"
        },
        "maxItems": 256,
        "minItems": 1,
        "type": "array"
       },
       "id": {
        "$ref": "#/$defs/blockRef"
       },
       "op": {
        "const": "replace_subtree"
       }
      },
      "required": [
       "op",
       "id",
       "blocks"
      ],
      "type": "object"
     },
     "op__replace_text": {
      "additionalProperties": false,
      "description": "Replaces text inside one block, markup preserved. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "find": {
        "description": "exact text within one block, markup included. Must match once in that block unless replace_all. A match touching markup metadata (a link destination) is rejected. Without id it must find one block.",
        "maxLength": 65536,
        "minLength": 1,
        "type": "string"
       },
       "id": {
        "$ref": "#/$defs/blockRef",
        "description": "optional — omit it and find locates the block: the find text must appear in exactly ONE block, or the op refuses (several matching blocks → the error lists candidate ids to retry with)"
       },
       "op": {
        "const": "replace_text"
       },
       "replace": {
        "description": "literal replacement, applied in the parsed text-and-marks model: markup bytes cannot create or remove marks. An empty string deletes the match. The result may not exceed 1048576 UTF-16 units.",
        "maxLength": 65536,
        "type": "string"
       },
       "replace_all": {
        "description": "default false — replaces every occurrence WITHIN the one matched block; it never widens the locator to several blocks",
        "type": "boolean"
       }
      },
      "required": [
       "op",
       "find",
       "replace"
      ],
      "type": "object"
     },
     "op__set_cell": {
      "additionalProperties": false,
      "description": "Sets one table cell, by row and column. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "col": {
        "description": "column id (full or unique suffix), or the column's header text (served as header on each column in the read) — case-insensitive, must name exactly one column",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "op": {
        "const": "set_cell"
       },
       "row": {
        "description": "row id (full or unique suffix), or the row's first-cell text — case-insensitive, must name exactly one row",
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "table_id": {
        "$ref": "#/$defs/blockRef",
        "description": "a table block"
       },
       "value": {
        "additionalProperties": {
         "$ref": "#/$defs/anyValue"
        },
        "description": "string = paragraph shorthand, null = clear, or a block object / array of blocks",
        "items": {
         "$ref": "#/$defs/anyValue"
        },
        "maxItems": 2048,
        "maxLength": 1048576,
        "maxProperties": 128,
        "type": [
         "string",
         "null",
         "object",
         "array"
        ]
       }
      },
      "required": [
       "op",
       "table_id",
       "row",
       "col",
       "value"
      ],
      "type": "object"
     },
     "op__set_properties": {
      "additionalProperties": false,
      "description": "Sets, adds to, removes from or unsets property values on the object. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "add": {
        "additionalProperties": {
         "items": {
          "maxLength": 4096,
          "type": "string"
         },
         "maxItems": 128,
         "type": "array"
        },
        "description": "list-shaped keys only (select, multi_select, objects, files): append entries without rewriting the array — existing entries are never duplicated; unknown option NAMES are created",
        "maxProperties": 128,
        "type": "object"
       },
       "op": {
        "const": "set_properties"
       },
       "remove": {
        "additionalProperties": {
         "items": {
          "maxLength": 4096,
          "type": "string"
         },
         "maxItems": 128,
         "type": "array"
        },
        "description": "list-shaped keys only: delete matching entries — absent entries (and absent keys) are a no-op; a key may appear in only one of set/unset/add/remove",
        "maxProperties": 128,
        "type": "object"
       },
       "set": {
        "additionalProperties": {
         "items": {
          "maxLength": 4096,
          "type": [
           "string",
           "number",
           "boolean",
           "null"
          ]
         },
         "maxItems": 2048,
         "maxLength": 1048576,
         "type": [
          "string",
          "number",
          "boolean",
          "array",
          "null"
         ]
        },
        "description": "property key → value (a list-shaped key takes an array of option names or ids); presence is meaningful — an empty array means present-but-empty; unknown select option names are created",
        "maxProperties": 128,
        "type": "object"
       },
       "unset": {
        "description": "property keys to remove",
        "items": {
         "maxLength": 256,
         "type": "string"
        },
        "maxItems": 128,
        "type": "array"
       }
      },
      "required": [
       "op"
      ],
      "type": "object"
     },
     "op__set_type": {
      "additionalProperties": false,
      "description": "Changes the object's type and converts the document to the new type's layout. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "op": {
        "const": "set_type"
       },
       "type": {
        "description": "the type the object becomes, by key, api key or name. Only layouts of one family convert (basic, todo, note, profile and bookmark among themselves; otherwise the same layout), and a refused change names the types this object can take. The document is rewritten for the new layout: to note the name becomes the first block, from note the first block becomes the name",
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "op",
       "type"
      ],
      "type": "object"
     },
     "op__update_block": {
      "additionalProperties": false,
      "description": "Changes fields of one existing block, found by id or by its text. One entry of {\"ops\":[…]}, the request body (example_body shows it wrapped); 1 to 512 entries apply in order as one edit — if any one is refused, none is applied.",
      "properties": {
       "id": {
        "$ref": "#/$defs/blockRef",
        "description": "the block to update — give this or match, never both"
       },
       "match": {
        "description": "alternative to id: exact text from the block, markdown markup included. Must match exactly one block (repeats in it are fine); several are refused with candidate ids. Give id or match, never both.",
        "maxLength": 65536,
        "minLength": 1,
