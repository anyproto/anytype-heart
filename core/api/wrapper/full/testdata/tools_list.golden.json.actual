  {
   "name": "delete_object",
   "description": "Delete an object. Only objects this key created can be deleted. The creator is recorded at creation time and never added later, so objects made in the app, imported, made by another member, or made before this route shipped are refused for good. System objects are a 403 as well. A dry run reports the verdict without the checks that run at archive time, so a deletable verdict can still meet a 403.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Probe deletability without writing",
      "type": "boolean"
     },
     "object_id": {
      "description": "Object id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "object_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "destructiveHint": true
   }
  },
  {
   "name": "create_discussion",
   "description": "Start an object's discussion. A discussion is the comment thread under an object, and it is a chat: the returned id is the `chat_id` for every chat operation, where `reply_to` makes a threaded reply. An object that already has one answers 200 with the same id and no `created`, so the call is safe to repeat. An object read serves the id as `discussion`. Chats, types, templates and system objects cannot hold one.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Report whether the object has a discussion without creating one",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "object_id": {
      "description": "Object id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "object_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "list_properties",
   "description": "List properties",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
