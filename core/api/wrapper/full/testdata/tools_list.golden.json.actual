{
 "tools": [
  {
   "name": "list_schemas",
   "description": "List schemas",
   "inputSchema": {
    "properties": {},
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "get_op_schema",
   "description": "Get an edit operation schema. The example is a single op object, ready to drop into an edit request's `ops` array, not a whole request body.",
   "inputSchema": {
    "properties": {
     "op": {
      "description": "Op name: set_properties, update_block, replace_subtree, insert_blocks, move_block, delete_block, replace_text, set_cell, update_view, insert_view, move_view, delete_view, add_items, remove_items",
      "type": "string"
     }
    },
    "required": [
     "op"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "get_schema",
   "description": "Get a schema",
   "inputSchema": {
    "properties": {
     "kind": {
      "description": "Schema kind, as listed by list_schemas",
      "type": "string"
     }
    },
    "required": [
     "kind"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "search_global",
   "description": "Search objects across spaces. Type keys and option names resolve per space; unresolved spaces produce warnings. Searches loaded spaces using query as full text over names and indexed content. total is a lower bound when clipped; use has_more to request further pages. Warnings report loading or unavailable stores. Each row carries space_id.",
   "inputSchema": {
    "properties": {
     "fields": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "uniqueItems": false
     },
     "filter": {
      "type": "string"
     },
     "filters": {
      "items": {
       "additionalProperties": {},
       "type": "object"
      },
      "type": "array",
      "uniqueItems": false
     },
     "ids": {
      "description": "How each row's space_id is spelled: compact (default) is the short space reference; full is the whole \u003ccid\u003e.\u003creplicationKey\u003e id, and the spelling to store outside this API",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "query": {
      "description": "Full-text query over object names and indexed content.",
      "type": "string"
     },
     "sorts": {
      "items": {
       "additionalProperties": {},
       "type": "object"
      },
      "type": "array",
      "uniqueItems": false
     },
     "type": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "list_spaces",
   "description": "List spaces. Returns only live spaces accessible to this API key. A space that is deleted, left, or still joining does not appear. has_not_granted_spaces is true when other live user spaces are excluded by the key's grant; if a requested space is missing, ask the user to grant access. This flag is independent of pagination: total and has_more describe only accessible spaces.",
   "inputSchema": {
    "properties": {
     "ids": {
      "description": "compact (default) is the short space reference; full is the whole \u003ccid\u003e.\u003creplicationKey\u003e id, and the spelling to store outside this API",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     }
    },
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_space",
   "description": "Create a space. A retry the server already handled makes a second space unless it carries the same idempotency key. A dry run validates the body and stops there; creating a space cannot be simulated.",
   "inputSchema": {
    "properties": {
     "description": {
      "type": "string"
     },
     "dry_run": {
      "description": "Validate the body without creating",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "ids": {
      "description": "compact (default) is the short space reference; full is the whole \u003ccid\u003e.\u003creplicationKey\u003e id of the new space, and the spelling to store outside this API",
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  {
   "name": "get_space",
   "description": "Get a space. Only live spaces are served. A space that is deleted, left, or still joining is a 404.",
   "inputSchema": {
    "properties": {
     "ids": {
      "description": "compact (default) is the short space reference; full is the whole \u003ccid\u003e.\u003creplicationKey\u003e id, and the spelling to store outside this API",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "update_space",
   "description": "Update a space. At least one of the two fields must be present; a field left out keeps its current value. The space icon and the default object type are not writable through this API.",
   "inputSchema": {
    "properties": {
     "description": {
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "ids": {
      "description": "compact (default) is the short space reference; full is the whole \u003ccid\u003e.\u003creplicationKey\u003e id, and the spelling to store outside this API",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "list_chats",
   "description": "List chats. Every row carries `unread_messages` and `unread_mentions`, read from the chat state without opening the chat. `include=discussions` adds the space's object discussions: a discussion row's id is the discussion's own id (usable on every chat route) and `parent_id` is the object it belongs to. `unread` keeps only rows with unread messages or unread mentions, and `total` then counts the kept rows.",
   "inputSchema": {
    "properties": {
     "include": {
      "description": "discussions adds object discussions to the list; omitted lists chats only",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Rows to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Rows to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "unread": {
      "description": "messages keeps rows with unread messages; mentions keeps rows with unread mentions",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_chat",
   "description": "Create a chat. Messages are not blocks. Add them through the messages route; a document edit cannot reach them.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "get_chat_messages",
   "description": "List chat messages. `after` alone walks forward, oldest first, continuing from `next_after`. Every other query is anchored at the newest end and walks backward from `next_before`. Both bounds are exclusive; messages are always ascending. `message_count` is the number of messages the chat holds now; `lifetime_message_count` counts every message ever posted. `offset` is refused.",
   "inputSchema": {
    "properties": {
     "after": {
      "description": "Return messages after this order id (exclusive)",
      "type": "string"
     },
     "before": {
      "description": "Return messages before this order id (exclusive)",
      "type": "string"
     },
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Messages to return",
      "type": "integer"
     },
     "reactions": {
      "description": "counts (default) returns the emoji counts; full adds the participant ids behind each count",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "add_chat_message",
   "description": "Send a chat message. The text is Markdown, formatted as described under Write chat messages. The cap is 8000 UTF-16 code units, where one emoji can cost two or more. Attachments are object ids, at most 32, and each one's kind is taken from the target's layout. In a discussion the text is stored as blocks.",
   "inputSchema": {
    "properties": {
     "attachments": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "uniqueItems": false
     },
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "reply_to": {
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "edit_chat_message",
   "description": "Update chat message text. Every mark is re-derived from the text you send, so a mark the old text carried and the new text does not spell out is lost; in a discussion the text replaces the message's blocks the same way, and dropped quotes or links are named in `warnings`. Attachments and the reply target survive; the style does in a space chat. Editing another member's message is a 403.",
   "inputSchema": {
    "properties": {
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "message_id": {
      "description": "Message id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "message_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "delete_chat_message",
   "description": "Delete a chat message. An attachment whose only reference was this message is erased for good afterwards, not moved to Bin. The response names those ids in `warnings`, and a dry run reports the same list without deleting anything. A message that does not exist is a 404 on the dry run too.",
   "inputSchema": {
    "properties": {
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "dry_run": {
      "description": "Report what would be deleted, attachments included, without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "message_id": {
      "description": "Message id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "message_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "destructiveHint": true
   }
  },
  {
   "name": "toggle_chat_reaction",
   "description": "Toggle a chat reaction. `added` says which way the toggle went. A dry run predicts it, but when there is no account identity to predict with it omits the field and says so in `warnings`.",
   "inputSchema": {
    "properties": {
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "dry_run": {
      "description": "Report the would-be outcome without committing",
      "type": "boolean"
     },
     "emoji": {
      "type": "string"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "message_id": {
      "description": "Message id",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "message_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "read_chat",
   "description": "Mark chat activity as read. `up_to` is inclusive; it and `last_state_id` come from one messages read: the newest order and the state's id. An empty value would silently mark nothing, so both are required. Later messages stay unread. The reactions scope takes neither field. The receipt carries the chat's state after the move when it could be read back.",
   "inputSchema": {
    "properties": {
     "chat_id": {
      "description": "Chat object id",
      "type": "string"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Replay guard: the same key with the same body replays the stored response",
      "type": "string"
     },
     "last_state_id": {
      "type": "string"
     },
     "scope": {
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "up_to": {
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "publish_chat_status",
   "description": "Publish chat status. Publishes encrypted ephemeral JSON on status/\u003cchat_id\u003e. Empty text is omitted so clients can show localized typing. data accepts any JSON value. The encoded payload is limited to 65,508 bytes. Status is not stored or replayed; receivers expire it. Success acknowledges acceptance, not delivery.",
   "inputSchema": {
    "properties": {
     "chat_id": {
      "description": "Chat or discussion id",
      "type": "string"
     },
     "data": {
      "description": "optional arbitrary JSON value: object, array, string, number, boolean or null"
     },
     "dry_run": {
      "description": "Validate without publishing",
      "type": "boolean"
     },
     "idempotency_key": {
      "description": "Unique key for this update; a reused key replays the response without publishing again",
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "text": {
      "description": "optional display text; empty or omitted is left out of the pubsub payload so receivers can show a localized typing label; JSON escaping and data consume the same byte budget",
      "maxLength": 65497,
      "type": "string"
     }
    },
    "required": [
     "chat_id",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "create_collection",
   "description": "Create a collection. Item ids are checked against the space; an id that does not resolve there is refused rather than dropped.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "items": {
      "items": {
       "description": "member object id",
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     },
     "name": {
      "maxLength": 4096,
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "name",
     "space_id"
    ],
    "type": "object"
   }
  },
  {
   "name": "get_collection_objects",
   "description": "List collection objects. A collection's objects are its membership, so without view the whole set comes back in the order the collection stores it and no view filter applies, even when the collection has one view. A view's filters and sorts apply only when view names it.",
   "inputSchema": {
    "properties": {
     "collection_id": {
      "description": "Collection object id",
      "type": "string"
     },
     "fields": {
      "description": "Comma-separated property keys to include per row",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "view": {
      "description": "Stored view id (exact or unique suffix). Omitted, no view applies and the whole membership is returned.",
      "type": "string"
     }
    },
    "required": [
     "collection_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "get_collection_views",
   "description": "List collection views",
   "inputSchema": {
    "properties": {
     "collection_id": {
      "description": "Collection object id",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "collection_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "upload_file",
   "description": "Upload a file. Send multipart/form-data with a `file` field, or JSON {\"url\": …}. A source that refuses the fetch, or a URL that cannot be fetched, is a 400 naming /url; only a genuine server fault answers 500. The id that comes back is the one file blocks, image blocks and icon_image values reference.",
   "inputSchema": {
    "properties": {
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "name": {
      "description": "names the stored object; omit to keep the name the source gives",
      "maxLength": 4096,
      "type": "string"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "url": {
      "maxLength": 4096,
      "type": "string"
     }
    },
    "required": [
     "space_id",
     "url"
    ],
    "type": "object"
   }
  },
  {
   "name": "list_members",
   "description": "List members",
   "inputSchema": {
    "properties": {
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "get_member_me",
   "description": "Get the current member. The identity is taken from the account this API runs against; there is no member id to send.",
   "inputSchema": {
    "properties": {
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "list_objects",
   "description": "List objects",
   "inputSchema": {
    "properties": {
     "fields": {
      "description": "Comma-separated property keys to include per row",
      "type": "string"
     },
     "limit": {
      "default": 25,
      "description": "Items to return",
      "type": "integer"
     },
     "offset": {
      "default": 0,
      "description": "Items to skip",
      "type": "integer"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "create_object",
   "description": "Create an object. A select value naming an option the property does not hold is refused unless `create_missing_options=true` is set. An unknown type or property key is rejected either way. The body is a full AnyBlock document or the shortcut {type, name, properties, markdown}; `formatVersion` or `blocks` picks the document form. `template` starts the object from one; absent, the type's `default_template` applies. Body: the shortcut body, or a full AnyBlock document; formatVersion or blocks picks the document form.",
   "inputSchema": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "create_missing_options": {},
       "dry_run": {},
       "markdown": {},
       "name": {},
       "properties": {},
       "space_id": {},
       "template": {},
       "type": {}
      },
      "required": [
       "type"
      ]
     },
     {
      "description": "a full AnyBlock document: formatVersion 2.0, properties, and blocks in preorder. It takes the shortcut's template member too; its schema and a worked example come from get_schema with kind object",
      "properties": {
       "create_missing_options": {},
       "dry_run": {},
       "space_id": {}
      }
     }
    ],
    "description": "the shortcut body, or a full AnyBlock document; formatVersion or blocks picks the document form",
    "properties": {
     "create_missing_options": {
      "description": "Create select options for names the property does not hold yet (default false: an unmatched name is refused)",
      "type": "boolean"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "markdown": {
      "description": "markdown body parsed into blocks server-side, part of the same single create (dry runs validate it too); at most 2048 parsed blocks. Start it at the first section: a leading heading that repeats the name is dropped, and with no name a leading # heading becomes the name",
      "maxLength": 1048576,
      "type": "string"
     },
     "name": {
      "description": "display name. The object displays it above its body, so a markdown body that repeats it as a heading shows it twice",
      "maxLength": 4096,
      "type": "string"
     },
     "properties": {
      "additionalProperties": {
       "items": {
        "$ref": "#/$defs/AnyValue"
       },
       "maxItems": 2048,
       "maxLength": 1048576,
       "type": [
        "string",
        "number",
        "boolean",
        "array",
        "null"
       ]
      },
      "maxProperties": 128,
      "type": "object"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     },
     "template": {
