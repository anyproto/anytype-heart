  {
   "name": "get_object",
   "description": "Get an object. A `block` subtree comes back flagged as a subtree, and no write path accepts that partial body. `format=md` is read-only; markdown cannot be sent back.",
   "inputSchema": {
    "properties": {
     "block": {
      "description": "Return only this block's subtree",
      "type": "string"
     },
     "format": {
      "description": "anyblock (default) or md",
      "type": "string"
     },
     "ids": {
      "description": "compact (default) is the edit shape, where minted block ids relabel to short suffixes; full is the export shape, with full ids everywhere, and the shape to send back. Object references are full and inline in both.",
      "type": "string"
     },
     "include": {
      "description": "Subset of properties,blocks (default both)",
      "type": "string"
     },
     "object_id": {
      "description": "Object id",
      "type": "string"
     },
     "outline": {
      "description": "Return the outline instead of full blocks: every block's indent/id/type plus its text truncated to 80 runes",
      "type": "boolean"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "object_id",
     "space_id"
    ],
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true
   }
  },
  {
   "name": "patch_object",
   "description": "Update an object. Applies ops in order as one atomic edit. A failed op or invalid result leaves the object unchanged. Text locators must match exactly one block. New block and view IDs are returned by payload position in `created_blocks` and `created_views`, compact by default or full with `ids=full`.",
   "inputSchema": {
    "properties": {
     "create_missing_options": {
      "description": "Create select options for names the property does not hold yet (default false: an unmatched name is refused)",
      "type": "boolean"
     },
     "dry_run": {
      "description": "Validate and report without committing",
      "type": "boolean"
     },
     "ids": {
      "default": "compact",
      "description": "ID spelling in created_blocks and created_views",
      "enum": [
       "compact",
       "full"
      ],
      "type": "string"
     },
     "if_match": {
      "description": "The etag the object must still carry",
      "type": "string"
     },
     "object_id": {
      "description": "Object id",
      "type": "string"
     },
     "ops": {
      "description": "applied in order as one edit, and if any one is refused none is applied. Each op's members, schema and example come from get_op_schema with its op name",
      "items": {
       "oneOf": [
        {
         "$ref": "#/$defs/op__add_items"
        },
        {
         "$ref": "#/$defs/op__delete_block"
        },
        {
         "$ref": "#/$defs/op__delete_view"
        },
        {
         "$ref": "#/$defs/op__insert_blocks"
        },
        {
         "$ref": "#/$defs/op__insert_view"
        },
        {
         "$ref": "#/$defs/op__move_block"
        },
        {
         "$ref": "#/$defs/op__move_view"
        },
        {
         "$ref": "#/$defs/op__remove_items"
        },
        {
         "$ref": "#/$defs/op__replace_subtree"
        },
        {
         "$ref": "#/$defs/op__replace_text"
        },
        {
         "$ref": "#/$defs/op__set_cell"
        },
        {
         "$ref": "#/$defs/op__set_properties"
        },
        {
         "$ref": "#/$defs/op__set_type"
        },
        {
         "$ref": "#/$defs/op__update_block"
        },
        {
         "$ref": "#/$defs/op__update_view"
        }
       ]
      },
      "maxItems": 512,
      "minItems": 1,
      "type": "array"
     },
     "space_id": {
      "description": "Space id",
      "type": "string"
     }
    },
    "required": [
     "object_id",
     "ops",
     "space_id"
    ],
    "type": "object",
