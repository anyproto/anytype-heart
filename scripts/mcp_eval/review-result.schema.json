      "type": "integer",
      "enum": [
        1
      ]
    },
    "run_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "correctly_blocked_by_capability",
        "model_failed",
        "server_failed",
        "fixture_failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "full_pass": {
      "type": "boolean"
    },
    "integrity_failure": {
      "type": "boolean"
    },
    "hook_status": {
