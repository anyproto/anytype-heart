    {
      "id": "dv1",
      "type": "dataview",
      "object_id": "bafyreitasks",
      "properties": [
        {
          "key": "name",
          "format": "text"
        },
        {
          "key": "customStatus",
          "format": "select"
        },
        {
          "key": "due_date",
          "format": "date"
        }
      ],
      "views": [
        {
          "id": "v1",
          "type": "kanban",
          "name": "By status",
          "group_by": "customStatus",
          "sorts": [
            {
              "property": "due_date",
              "empty_placement": "end",
              "id": "s1"
            }
          ],
          "filters": [
            {
              "property": "due_date",
              "condition": "less",
              "date_preset": "current_week",
              "id": "f1"
            },
            {
              "operator": "or",
              "filters": [
                {
                  "property": "customStatus",
                  "condition": "in",
                  "value": [
                    "In progress",
                    "Done"
                  ],
                  "id": "f2"
                },
                {
                  "property": "done",
                  "condition": "empty",
                  "id": "f3"
                }
              ]
            }
          ],
          "columns": [
            {
              "property": "name"
            },
            {
              "property": "due_date",
              "hidden": true,
              "width": 120,
              "aggregation": "count_distinct",
              "align": "right"
            }
          ],
          "groups": [
            {
              "id": "g1",
              "background_color": "red"
            },
            {
              "id": "g2",
              "hidden": true
            }
          ],
          "object_orders": [
            {
              "group_id": "g1",
              "object_ids": [
                "bafyreitask1"
              ]
            }
          ]
        }
