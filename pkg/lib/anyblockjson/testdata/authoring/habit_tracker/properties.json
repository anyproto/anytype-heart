{
  "$schema": "https://schemas.anytype.io/anyblock/1/authoring/properties.schema.json",
  "version": 1,
  "properties": [
    {
      "property": "frequency",
      "name": "Frequency",
      "format": "select",
      "options": [
        { "name": "Daily", "color": "lime" },
        { "name": "Weekly", "color": "blue" }
      ],
      "description": "How often the habit repeats."
    },
    {
      "property": "streak",
      "name": "Streak",
      "format": "number",
      "description": "Days in a row, so far."
    },
    {
      "property": "last_done",
      "name": "Last done",
      "format": "date",
      "description": "When you last did it."
    }
  ]
}
